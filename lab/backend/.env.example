# Copy this file to .env (or export these as real environment variables)
# and fill in your own Supabase project's connection info.
# NEVER commit the filled-in version.

# Supabase project -> Settings -> Database -> Connection string (use the
# "Session pooler" or direct connection URI, JDBC form):
SUPABASE_DB_URL=jdbc:postgresql://<PROJECT_REF>.supabase.co:5432/postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-db-password-here

# Optional: override if your React dev server runs on a different port
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173
